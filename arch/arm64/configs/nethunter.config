# Nethunter - General
# LKMs support is already configured in custom.config
CONFIG_LOCALVERSION="-Nethunter-KSU@ravindu644"
CONFIG_DEFAULT_HOSTNAME="kali"
CONFIG_SYSVIPC=y

# We are enabling all possible NetHunter drivers as LKMs.
# This allows us to compile the kernel with a wide range of drivers
# while maintaining a consistent kernel image size.
# As a result, there is no need to worry about larger boot.img sizes or
# bootloader failures due to flashing issues.

# Nethunter - Bluetooth
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIBCM203X=m
CONFIG_BT_HCIBPA10X=m
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_HCIVHCI=m
CONFIG_ANDROID_BINDER_IPC=y

# Nethunter - MAC80211
CONFIG_MAC80211=m
CONFIG_MAC80211_MESH=y

# Nethunter - Ethernet
CONFIG_USB_RTL8150=m
CONFIG_USB_RTL8152=m

# NetHunter - Wireless LAN

# Atheros/Qualcomm devices
CONFIG_ATH_CARDS=y
CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_BTCOEX_SUPPORT=y
CONFIG_CARL9170=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m

# MediaTek devices
CONFIG_WL_MEDIATEK=y
CONFIG_MT7601U=m

# Ralink devices
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y

# Realtek devices
CONFIG_88XXAU=m
CONFIG_RTL8187=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_ZD1211RW=m
CONFIG_USB_NET_RNDIS_WLAN=m

# Nethunter - SDR
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_AIRSPY=m
CONFIG_USB_HACKRF=m
CONFIG_USB_MSI2500=m
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n
CONFIG_DVB_RTL2830=m
CONFIG_DVB_RTL2832=m
CONFIG_DVB_RTL2832_SDR=m
CONFIG_DVB_SI2168=m

# Nethunter - USB Support (Gadget, Modems, OTG)
CONFIG_USB_OTG=y
CONFIG_USB_OTG_FSM=y
CONFIG_USB_WDM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_F_UVC=y
CONFIG_CONFIG_USB_WDM=y
